{"schema":"mirrorecma.blind-counter-evidence/v1","createdAt":"2026-09-08T07:56:47.956Z","platform":{"platform":"linux","arch":"x64","node":"v24.15.0"},"identities":{"mirrorEcmaCompiledTree":"378e3eecc5872c3f11615a55e8e9d895fab257ca1616bcc487886b61c81e904b","packedGateSdkTree":"f10d3f2cae45497490aefa420c12df4ff88ca86135975b6e661c2064f4f34f20","mirrorBinarySha256":"d347838babd0ae807388974c8957d6b84a17e9423c41ac9c1917a7506f9c140f","counterInterfaceLockSha256":"e3ffeb39c619ad311f1a74580b8b7f33a8248c7e662dc6e63a8ebcb640ca2338","privateSpecSha256":"19f7113924c670f82d2f4b9a1101eedc623e111c4de9e83bad99a35b8e524748","privateTraceSha256":["be77e4a113c7668dcc8c667e86ed55c88a87d1a9350f8f78b7ad7534b444eb5a","c6eebdbdbd5f2675c34a06cd3eb4a3afea1ae289f84ba7fbc39df00726df5a9d","c6eebdbdbd5f2675c34a06cd3eb4a3afea1ae289f84ba7fbc39df00726df5a9d","1d893b0345f1809c18dee35e6a584325ce473ae3a59b4071549a55ff4fcb2330"],"publicBundleHash":"0518f603f7bf720b0973e43b5bfb0de974c72cb189b1c9bf9b0f527ce0e2b8ab","publicManifestDigest":"193d6cc187d05c18f02ad483a44f8ad0c1634b02083df241df08b9281b045d1c","modelRevisionId":"private-counter-fresh-v1"},"source":{"initial":{"entries":[],"digest":"4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945"},"afterAuthoring":{"entries":[{"path":"adapter.mjs","kind":"file","size":449,"sha256":"c8442d9d91e9b836414a3becd64d42cf0f0bcf943f6963e08b814b884a335a8a","executable":false},{"path":"build.mjs","kind":"file","size":1211,"sha256":"7863f673f1ddb17beb1578c058dab654f39f7e021d24e0b11f3ca7187d28dd21","executable":false}],"digest":"e0e4a4672aed30e8dcfd840e39eaa025f42e8a6a6881ab076f9ac13aeceafa81"},"gateSourceHash":"e0e4a4672aed30e8dcfd840e39eaa025f42e8a6a6881ab076f9ac13aeceafa81","sourceHashMatched":true},"preparation":{"preparedRevision":1,"artifactId":"a4d7d718c9f6ffdfa49b2995e2396995","artifactHash":"58767d6769ab3a6681c4dfc54289333db2fea7c0c7c951a1b9888d21cd58bafe","manifestHash":"0647fb8bb3b48172d906ff569717a4bad0835f0d4bd6b25422c325df22f068c8","runtime":"node-v1","policyId":"blind.counter.node","authoringSeal":{"status":"failed","code":"STATE_INVALID","stage":"authoring","rejection":"immediate"}},"guards":{"authoring":"passed","build":"passed","execution":"passed-by-createAdapter-guard","privatePathStringsAbsentFromPolicy":true,"privatePathStringsAbsentFromSubmittedSource":true},"mountAudit":{"selectedPolicy":true,"submissionBindingMatched":true,"privatePathsOutsideSubmissionAndRuntimeMounts":true,"privatePathStringsAbsentFromPolicy":true},"broker":{"protocol":"mirrorecma.blind-counter-broker/v1","tools":["author.node","author.python"],"transcript":[{"ordinal":1,"request":{"id":1,"op":"contract"},"response":{"id":1,"ok":true,"contract":{"schema":"mirrorecma.blind-counter-author/v1","protocol":"mirrorecma.blind-counter-broker/v1","files":{"COUNTER_CONTRACT.md":"# Counter public implementation contract\n\nSubmit exactly two ECMAScript modules at the workspace root:\n\n- `adapter.mjs` exports `createAdapter()`.\n- `build.mjs` exports `runBuild()` and performs the submission's own public\n  checks. It may import `adapter.mjs`. A successful call returns `undefined`.\n\n`createAdapter()` returns an object with exactly these public operations:\n\n```text\nactions.Initialize({})\nactions.Tick({ Stride })\nobserve() -> { Count }\n```\n\nThe implementation requirements are:\n\n1. `Initialize` resets the implementation's stored count to `0n`.\n2. `Tick` adds the supplied `Stride` bigint to that stored count.\n3. `observe` returns the actual stored count as the bigint field `Count`.\n4. Action functions return `undefined`. They may be synchronous or async.\n5. `createAdapter` may be synchronous or async. An optional `dispose` function\n   may be returned.\n6. The adapter must expose exactly `Initialize` and `Tick` in `actions`.\n\nThe evaluator holds its model, replay cases, expected states, and diagnostics\nprivately. The sandbox gives authoring tools a writable `/workspace`, a private\nscratch directory, the approved Node and Python runtimes, no network, and no\ninherited host environment. Use relative paths and keep all submission files\nin the workspace root.\n\nThe build phase runs `runBuild()` in a fresh restricted environment over a\nread-only frozen source snapshot. The evaluator then packages `adapter.mjs`\nfrom that snapshot for the restricted worker. No live authoring path is mounted\nin the evaluation worker.\n","counter-port.d.ts":"export interface CounterAdapter {\n  readonly actions: {\n    Initialize(input: Readonly<Record<string, never>>): void | Promise<void>;\n    Tick(input: Readonly<{ Stride: bigint }>): void | Promise<void>;\n  };\n  observe(): Readonly<{ Count: bigint }> | Promise<Readonly<{ Count: bigint }>>;\n  dispose?(): void | Promise<void>;\n}\n\nexport type CreateCounterAdapter = () => CounterAdapter | Promise<CounterAdapter>;\n"},"manifest":{"actions":[{"id":"Tick","inputs":[{"id":"Stride","type":{"kind":"int"}}]}],"initializers":[{"id":"Initialize","inputs":[]}],"interfaceDigest":"193d6cc187d05c18f02ad483a44f8ad0c1634b02083df241df08b9281b045d1c","observations":[{"id":"Count","type":{"kind":"int"}}],"schema":"mirrorgate.port/v1"},"workspace":{"cwd":".","sandboxPath":"/workspace","initiallyEmpty":true},"tools":[{"id":"author.node","runtime":"Node","arguments":"fixed executable plus bounded argv"},{"id":"author.python","runtime":"Python","arguments":"fixed isolated executable plus bounded argv"}],"submission":{"files":["adapter.mjs","build.mjs"],"submitOperation":"submit"}}}},{"ordinal":2,"request":{"id":2,"op":"exec","toolId":"author.node","args":["-e","const fs=require('fs'); console.log(JSON.stringify(fs.readdirSync('.')));"]},"response":{"id":2,"ok":true,"exitCode":0,"stdout":"[]\n","stderr":"","stdoutBytes":3,"stderrBytes":0,"stdoutTruncated":false,"stderrTruncated":false}},{"ordinal":3,"request":{"id":3,"op":"exec","toolId":"author.node","args":["-e","const fs=require('fs');\nfs.writeFileSync('adapter.mjs', `/**\n * Create an isolated in-memory Counter adapter.\n * @returns {{actions: {Initialize(input: object): void, Tick(input: {Stride: bigint}): void}, observe(): {Count: bigint}}}\n */\nexport function createAdapter() {\n  let count = 0n;\n\n  const actions = {\n    Initialize(_input) {\n      count = 0n;\n    },\n\n    Tick({ Stride }) {\n      count += Stride;\n    },\n  };\n\n  return {\n    actions,\n    observe() {\n      return { Count: count };\n    },\n  };\n}\n`);\nfs.writeFileSync('build.mjs', `import assert from 'node:assert/strict';\nimport { createAdapter } from './adapter.mjs';\n\n/** Run submission-owned contract checks. */\nexport async function runBuild() {\n  const adapter = await createAdapter();\n\n  assert.deepEqual(Object.keys(adapter).sort(), ['actions', 'observe']);\n  assert.deepEqual(Object.keys(adapter.actions).sort(), ['Initialize', 'Tick']);\n\n  assert.equal(await adapter.actions.Initialize({}), undefined);\n  assert.deepEqual(await adapter.observe(), { Count: 0n });\n\n  assert.equal(await adapter.actions.Tick({ Stride: 7n }), undefined);\n  assert.deepEqual(await adapter.observe(), { Count: 7n });\n\n  await adapter.actions.Tick({ Stride: -12n });\n  assert.deepEqual(await adapter.observe(), { Count: -5n });\n\n  const large = (1n << 100n) + 123n;\n  await adapter.actions.Tick({ Stride: large });\n  assert.deepEqual(await adapter.observe(), { Count: large - 5n });\n\n  await adapter.actions.Initialize({});\n  assert.deepEqual(await adapter.observe(), { Count: 0n });\n\n  const independent = await createAdapter();\n  await independent.actions.Tick({ Stride: 3n });\n  assert.deepEqual(await independent.observe(), { Count: 3n });\n  assert.deepEqual(await adapter.observe(), { Count: 0n });\n}\n`);\nconsole.log(fs.readdirSync('.').sort().join('\\n'));"]},"response":{"id":3,"ok":true,"exitCode":0,"stdout":"adapter.mjs\nbuild.mjs\n","stderr":"","stdoutBytes":22,"stderrBytes":0,"stdoutTruncated":false,"stderrTruncated":false}},{"ordinal":4,"request":{"id":4,"op":"exec","toolId":"author.node","args":["--input-type=module","-e","import { runBuild } from './build.mjs'; const result = await runBuild(); if (result !== undefined) throw new Error('runBuild must return undefined'); console.log('public checks passed');"]},"response":{"id":4,"ok":true,"exitCode":0,"stdout":"public checks passed\n","stderr":"","stdoutBytes":21,"stderrBytes":0,"stdoutTruncated":false,"stderrTruncated":false}},{"ordinal":5,"request":{"id":5,"op":"submit"},"response":{"id":5,"ok":true,"status":"submitted"}}]},"gateEvents":{"authoring.output":4,"build.output":1,"operation.finished":6,"session.closed":1,"worker.closing":1,"worker.exited":1,"worker.ready":1,"worker.started":1},"diagnostics":[{"kind":"lifecycle","stage":"worker.operation.dispatched","family":"application","summaryHash":"840ff12b10f194ac8984ca58a9bd4e29e534b889530d4c213fc81265bce37253"},{"kind":"lifecycle","stage":"worker.operation.dispatched","family":"application","summaryHash":"efb304cbf44b5f0b6b445a5a41a310c9b3bf051b2c18aab824f20b65f0d81ffa"},{"kind":"lifecycle","stage":"worker.operation.dispatched","family":"application","summaryHash":"efb304cbf44b5f0b6b445a5a41a310c9b3bf051b2c18aab824f20b65f0d81ffa"},{"kind":"lifecycle","stage":"worker.operation.dispatched","family":"application","summaryHash":"efb304cbf44b5f0b6b445a5a41a310c9b3bf051b2c18aab824f20b65f0d81ffa"},{"kind":"lifecycle","stage":"worker.operation.dispatched","family":"application","summaryHash":"efb304cbf44b5f0b6b445a5a41a310c9b3bf051b2c18aab824f20b65f0d81ffa"},{"kind":"lifecycle","stage":"worker.operation.dispatched","family":"application","summaryHash":"efb304cbf44b5f0b6b445a5a41a310c9b3bf051b2c18aab824f20b65f0d81ffa"},{"kind":"lifecycle","stage":"worker.operation.dispatched","family":"application","summaryHash":"efb304cbf44b5f0b6b445a5a41a310c9b3bf051b2c18aab824f20b65f0d81ffa"},{"kind":"lifecycle","stage":"worker.operation.dispatched","family":"application","summaryHash":"efb304cbf44b5f0b6b445a5a41a310c9b3bf051b2c18aab824f20b65f0d81ffa"},{"kind":"li