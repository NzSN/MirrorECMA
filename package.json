{
  "name": "mirrorecma",
  "version": "2.0.0",
  "description": "TypeScript client for ModelMirros protocol",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": { "mirrorecma": "./dist/cli.js" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./project": { "types": "./dist/project.d.ts", "import": "./dist/project.js" },
    "./*": "./*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "node scripts/clean-dist.mjs && tsc",
    "build": "node scripts/clean-dist.mjs && tsc",
    "check": "tsc --noEmit",
    "check:model-interface": "tsc -p tsconfig.model-interface.json --noEmit",
    "check:examples": "tsc -p tsconfig.examples.json --noEmit",
    "build:examples": "tsc -p tsconfig.examples.json",
    "example:counter": "pnpm run build:examples && node dist-test/examples/generated-counter/run.js",
    "example:counter:broken": "pnpm run build:examples && node dist-test/examples/generated-counter/run.js --broken",
    "example:counter:live": "pnpm run build:examples && node dist-test/examples/generated-counter/run.js --live",
    "smoke:generated-counter": "pnpm run build:examples && node dist-test/test/generated-counter.smoke.js",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules\" jest",
    "smoke": "node --loader ts-node/esm test/smoke.test.ts",
    "smoke:model-interface": "node --loader ts-node/esm test/model-interface-counter.smoke.ts",
    "example:queue": "pnpm run build:examples && node dist-test/examples/work-queue/run.js",
    "example:queue:broken": "pnpm run build:examples && node dist-test/examples/work-queue/run.js --broken",
    "example:queue:live": "pnpm run build:examples && node dist-test/examples/work-queue/run.js --live",
    "example:queue:acceptance": "pnpm run build:application-validation && node dist-test/examples/work-queue/acceptance-cli.js",
    "smoke:work-queue": "pnpm run build:examples && node dist-test/test/work-queue.smoke.js",
    "smoke:async-generated-counter": "pnpm run build:examples && node dist-test/test/async-generated-counter.smoke.js",
    "ci": "bash scripts/ci/check.sh",
    "example:mbt-counter": "pnpm run build:examples && node dist-test/examples/mbt-counter/run.js",
    "example:mbt-counter:broken": "pnpm run build:examples && node dist-test/examples/mbt-counter/run.js --broken",
    "test:mbt-counter": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --runInBand test/mbt-counter.test.ts",
    "smoke:mbt-counter": "pnpm run build:examples && node dist-test/test/mbt-counter.smoke.js",
    "check:package-boundary": "pnpm run build && node scripts/check-package-boundary.mjs",
    "check:installed-suite": "node scripts/check-installed-suite.mjs",
    "build:application-validation": "pnpm run build && tsc -p tsconfig.examples.json && tsc -p tsconfig.application-validation.json",
    "example:transfer:acceptance": "pnpm run build:application-validation && node examples/application-validation/run.mjs persistent-transfer",
    "example:lease:acceptance": "pnpm run build:application-validation && node examples/application-validation/run.mjs lease-service"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.19",
    "jest": "^30.4.2",
    "jest-cli": "^30.4.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.5"
  },
  "packageManager": "pnpm@11.22.0"
}
