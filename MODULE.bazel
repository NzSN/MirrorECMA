module(
    name = "mirrorecma",
    version = "1.0.0",
)

bazel_dep(name = "rules_shell", version = "0.6.1")

bazel_dep(name = "modelmirrors", version = "0.1.0.0")
git_override(
    module_name = "modelmirrors",
    remote = "https://github.com/NzSN/ModelMirrors",
    # Explorer feature, merged to main in ModelMirros (2cabc40). A pinned hash
    # does NOT follow branch movement: repoint explicitly to pick up newer
    # mirror changes.
    commit = "2cabc401f0eb7c05131beb3a2e16afd7ec32e247",
)

# Transitive overrides: modelmirros uses non-BCR versions of rules_haskell/rules_sh
# for Bazel 8 compatibility. bzlmod requires the root module to repeat override pins
# because non-root overrides don't propagate transitively.
git_override(
    module_name = "rules_haskell",
    remote = "https://github.com/NzSN/rules_haskell",
    commit = "932d7545df965cc9f62a181a948df73fa08fdaf8",
)

git_override(
    module_name = "rules_sh",
    remote = "https://github.com/tweag/rules_sh",
    commit = "c28667efc2fd9c95ceada90ce2b27d928fa36971",
)

bazel_dep(name = "rules_haskell", version = "1.0")

stack_snapshot_dev = use_extension(
    "@rules_haskell//extensions:stack_snapshot.bzl",
    "stack_snapshot",
    dev_dependency = True,
)
stack_snapshot_dev.snapshot(local_snapshot = "@modelmirrors//:stackage_snapshot.yaml")

stack_snapshot = use_extension(
    "@rules_haskell//extensions:stack_snapshot.bzl",
    "stack_snapshot",
)
use_repo(stack_snapshot, "stackage", "stackage-exe")

bazel_dep(name = "platforms", version = "1.0.0")

bazel_dep(name = "aspect_rules_js", version = "2.4.2")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "npm")

bazel_dep(name = "rules_nodejs", version = "6.7.4")
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "22.14.0")
use_repo(node, "nodejs_toolchains")

bazel_dep(name = "aspect_rules_ts", version = "3.8.10")

bazel_dep(name = "aspect_rules_jest", version = "0.25.2")

rules_ts_ext = use_extension("@aspect_rules_ts//ts:extensions.bzl", "ext")
rules_ts_ext.deps(
    ts_version = "5.9.3",
)
use_repo(rules_ts_ext, "npm_typescript")
