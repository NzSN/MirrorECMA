load("@npm//:defs.bzl", "npm_link_all_packages")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_js//js:defs.bzl", "js_test")

npm_link_all_packages(name = "node_modules")

ts_config(
    name = "tsconfig",
    src = "tsconfig.bazel.json",
    deps = [
        ":node_modules/@types/node",
    ],
)

ts_project(
    name = "lib_src",
    srcs = glob([
        "src/**/*.ts",
        "test/smoke.test.ts"]),
    tsconfig = ":tsconfig",
    transpiler = "tsc",
    declaration = True,
)


genrule(
    name = "package_json",
    srcs = ["package.bazel.json"],
    outs = ["package.json"],
    cmd = "cp $(execpath package.bazel.json) $@",
)

npm_package(
    name = "lib",
    srcs = [
        ":lib_src",
        ":package_json",
    ],
    package = "mirrorecma",
    visibility = ["//visibility:public"],
)

js_test(
    name = "smoke",
    entry_point = "test/smoke.test.js",
    data = [
        ":lib_src",
        "@modelmirrors//app:ModelMirrors",
        "specs/Counter.tla",
    ],
    env = {
        "MIRROR_BIN": "$(rlocationpath @modelmirrors//app:ModelMirrors)",
    },
    env_inherit = ["PATH"],
)
