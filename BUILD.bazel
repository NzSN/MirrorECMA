genrule(
    name = "lib",
    srcs = glob(["src/**/*.ts"]) + [
        "tsconfig.json",
        "package.json",
    ],
    outs = [
        "index.js",
        "index.d.ts",
        "protocol.js",
        "protocol.d.ts",
        "client.js",
        "client.d.ts",
        "transport.js",
        "transport.d.ts",
    ],
    cmd = """
        WS=$$(dirname $$(realpath $(execpath package.json)))
        "$$WS"/node_modules/.bin/tsc \
            --project "$$WS"/tsconfig.json \
            --outDir $(RULEDIR) \
            --rootDir "$$WS"/src
    """,
    tags = ["local", "no-sandbox"],
)

load("@rules_shell//shell:sh_test.bzl", "sh_test")

sh_test(
    name = "smoke",
    srcs = ["scripts/smoke_bazel"],
    args = ["$(execpath @modelmirros//app:ModelMirrors)"],
    data = [
        "@modelmirros//app:ModelMirrors",
        "test/smoke.test.ts",
        "specs/Counter.tla",
        "package.json",
        "jest.config.cjs",
        "tsconfig.json",
    ],
    tags = ["local", "no-sandbox"],
    env = {"NODE_OPTIONS": "--experimental-vm-modules"},
)
