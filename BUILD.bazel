load("@npm//:defs.bzl", "npm_link_all_packages")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")

npm_link_all_packages(name = "node_modules")

ts_config(
    name = "tsconfig",
    src = "tsconfig.bazel.json",
    deps = [
        ":node_modules/@types/node",
    ],
)

ts_project(
    name = "lib_src",
    srcs = glob(["src/**/*.ts"]),
    tsconfig = ":tsconfig",
    transpiler = "tsc",
    declaration = True,
)

load("@aspect_rules_js//npm:defs.bzl", "npm_package")

genrule(
    name = "package_json",
    srcs = ["package.bazel.json"],
    outs = ["package.json"],
    cmd = "cp $(execpath package.bazel.json) $@",
)

npm_package(
    name = "lib",
    srcs = [
        ":lib_src",
        ":package_json",
    ],
    package = "mirrorecma",
    visibility = ["//visibility:public"],
)

load("@aspect_rules_js//js:defs.bzl", "js_test")

js_test(
    name = "smoke",
    entry_point = "scripts/jest_runner.mjs",
    data = glob(["src/**/*.ts", "test/**/*.ts"]) + [
        "@modelmirrors//app:ModelMirrors",
        "specs/Counter.tla",
        "jest.config.cjs",
        "package.json",
        "tsconfig.json",
        ":node_modules/jest-cli",
        ":node_modules/ts-jest",
        ":node_modules/typescript",
        ":node_modules/@types/jest",
        ":node_modules/@types/node",
    ],
    env = {
        "MIRROR_BIN": "$(rlocationpath @modelmirrors//app:ModelMirrors)",
        "NODE_OPTIONS": "--experimental-vm-modules",
    },
    env_inherit = ["PATH"],
)
